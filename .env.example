############################
# WhatsApp Buddy - .env.example
#
# Copy this file to `.env` and fill in the real values.
# Never commit the real `.env` with secrets to git.
############################

# -------------------------
# Database (PostgreSQL)
# -------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# -------------------------
# OpenAI
# -------------------------
OPENAI_API_KEY=your-openai-key

# -------------------------
# WhatsApp (Meta Cloud API)
# -------------------------
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id

# -------------------------
# Plug & Pay / PlugAndPay
# -------------------------
# Webhook token (if provider can send a secret header/body field)
PLUG_N_PAY_TOKEN=your-plugnpay-webhook-token

# API token for GET /v2/orders/{id} (from PlugAndPay admin)
PLUG_N_PAY_API_TOKEN=your-plugnpay-api-token

# API base URL to fetch order by ID when webhook has no phone
PLUG_N_PAY_API_URL=https://api.plugandpay.com

# Optional: map order amount (EUR) to credits when API payload has no products/meta.
# Example: 9.99 EUR -> 100 credits, 4.99 EUR -> 50 credits
# AMOUNT_TO_CREDITS=9.99:100,4.99:50

# -------------------------
# App / Logging
# -------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO

# -------------------------
# Book / RAG
# -------------------------
BOOK_TOTAL_PAGES=228

